unless(maeAddOutput("VDD_VALUE" "Oscillator" ?expr "VAR(\"VDD\")" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HB_F0_Hz" "Oscillator" ?expr "drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HB_DIFF_PEAK_V" "Oscillator" ?expr "mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HB_VDD_SRC_IDC_A" "Oscillator" ?expr "0-real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0))" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HB_VDD_SRC_PDC_W" "Oscillator" ?expr "(0-real(value((0+getData(\"/VDD\" ?result \"hb_fd\")) 0))*real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0)))" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HBNOISE_PN_10000Hz_dBc_Hz" "Oscillator" ?expr "(10*log10(2)+20*log10(value(getData(\"out\" ?result \"hbnoise_pm\") 10000.0)/mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))))" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("VCO_HBNOISE_FOM_10000Hz_dB" "Oscillator" ?expr "(10*log10(2)+20*log10(value(getData(\"out\" ?result \"hbnoise_pm\") 10000.0)/mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))))-20*log10(drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)/10000.0)+10*log10(1000*(0+(0-real(value((0+getData(\"/VDD\" ?result \"hb_fd\")) 0))*real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0)))))" ?plot t ?save t ?session s) error("add output failed"))
unless(maeAddOutput("SAVE_/OUTP" "Oscillator" ?outputType "net" ?signalName "/OUTP" ?plot nil ?save t ?session s) error("add save failed"))
unless(maeAddOutput("SAVE_/OUTN" "Oscillator" ?outputType "net" ?signalName "/OUTN" ?plot nil ?save t ?session s) error("add save failed"))
unless(maeAddOutput("SAVE_/VDD" "Oscillator" ?outputType "net" ?signalName "/VDD" ?plot nil ?save t ?session s) error("add save failed"))
unless(maeAddOutput("SAVE_/VDD_SRC/PLUS" "Oscillator" ?outputType "terminal" ?signalName "/VDD_SRC/PLUS" ?plot nil ?save t ?session s) error("add save failed"))
unless(maeSaveSetup(?session s) error("save setup failed"))
maeCloseSession(?session s)
