unless(cdfFindParamByName(c "DEC_CODE") cdfCreateParam(c ?name "DEC_CODE" ?type "string" ?defValue "0" ?parseAsCEL "yes" ?parseAsNumber "yes"))
unless(cdfFindParamByName(c "INVERT") cdfCreateParam(c ?name "INVERT" ?type "string" ?defValue "0" ?parseAsCEL "yes" ?parseAsNumber "yes"))
cdfSaveCDF(c)
)
