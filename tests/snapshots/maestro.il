unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "dec" ?session s) "") error("reopen analysis mismatch"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "useDiscrete" ?session s) t) error("reopen analysis mismatch"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "values" ?session s) list("10000.0" "20000.0")) error("reopen analysis mismatch"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "noisetype" ?session s) "timeaverage") error("reopen analysis mismatch"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "noiseout" ?session s) list("pm")) error("reopen analysis mismatch"))
