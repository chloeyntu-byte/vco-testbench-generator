close(o) maeCloseSession(?session s)

; Preserve explicit family coordinates (not inferred signal-name sidebands).
procedure(tbgenEmitWave(out analysisName signalName wave coordinates)
 let((xx yy vv xv)
  cond(
   (numberp(wave)
    fprintf(out "RAW\t%L\t%s\t0\t%.17g\t%.17g\n" analysisName signalName real(wave)*1.0 imag(wave)*1.0))
   (drIsWaveform(wave)
    xx=drGetWaveformXVec(wave) yy=drGetWaveformYVec(wave)
    for(index 0 min(2 drVectorLength(xx)-1)
     vv=drGetElem(yy index) xv=drGetElem(xx index)
     when(numberp(vv) && numberp(xv)
      fprintf(out "FAMILY_RAW\t%L\t%s\t%L\t%.17g\t%.17g\t%.17g\n"
       analysisName signalName coordinates xv real(vv) imag(vv)))))
   (famIsFamily(wave)
    foreach(coordinate famGetSweepValues(wave)
     tbgenEmitWave(out analysisName signalName famValue(wave coordinate)
      append(coordinates list(list(famGetSweepName(wave) coordinate))))))
 ))
)

; Required expression waves export all actual samples, units and family coordinates.
procedure(tbgenEmitOutput(out outputName wave coordinates)
 let((xx yy vv xv)
  cond(
   (numberp(wave)
    fprintf(out "SCALAR_SAMPLE\t%s\t%.17g\t%.17g\n" outputName real(wave)*1.0 imag(wave)*1.0))
   (drIsWaveform(wave)
    xx=drGetWaveformXVec(wave) yy=drGetWaveformYVec(wave)
    fprintf(out "WAVE_META\t%s\t%L\t%L\t%L\n" outputName coordinates xx->units yy->units)
    for(index 0 drVectorLength(xx)-1
     vv=drGetElem(yy index) xv=drGetElem(xx index)
     fprintf(out "WAVE_SAMPLE\t%s\t%.17g\t%.17g\t%.17g\n" outputName xv real(vv) imag(vv))))
   (famIsFamily(wave)
    foreach(coordinate famGetSweepValues(wave)
     tbgenEmitOutput(out outputName famValue(wave coordinate)
      append(coordinates list(list(famGetSweepName(wave) coordinate)))))))))

envSetVal("asimenv.startup" "projectDir" 'string "/path/to/workspace/simulation")
envSetVal("adexl.historyNamePrefix" "showNameHistoryForm" 'boolean nil)
envSetVal("adexl.simulation" "saveLastNHistoryEntries" 'int 1000)
s=maeOpenSetup("example_tb" "OscillatorTB" "maestro" ?mode "a")
unless(s error("open setup failed"))
when(axlIsSessionReadOnly(s) error("SETUP_OPEN_OR_LOCKED: close GUI or use an in-GUI plugin"))
unless(equal(sort(maeGetEnabledAnalysis("Oscillator" ?session s) 'alphalessp) sort(list("hb" "hbnoise") 'alphalessp)) error("effective analyses changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "oscana" ?session s) t) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "p" ?session s) "/OUTP") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "n" ?session s) "/OUTN") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "HBFreq1" ?session s) "1G") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "HBHarm1" ?session s) "15") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "fundfreqs" ?session s) list("1G")) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "maxharms" ?session s) list("15")) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "errpreset" ?session s) "conservative") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "oscic" ?session s) "lin") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "oscmethod" ?session s) "twotier") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "pinnode" ?session s) "/OUTP") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "pinnodeminus" ?session s) "/OUTN") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "pinnoderank" ?session s) "1") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hb" ?option "autosteady" ?session s) "yes") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "sweeptype" ?session s) "relative") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "relharmvec" ?session s) list("1")) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "outType" ?session s) "voltage") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "p" ?session s) "/OUTP") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "n" ?session s) "/OUTN") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "maxsideband" ?session s) "15") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "start" ?session s) "") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "stop" ?session s) "") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "incrType" ?session s) "Automatic") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "dec" ?session s) "") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "useDiscrete" ?session s) t) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "values" ?session s) list("10000.0" "20000.0")) error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "noisetype" ?session s) "timeaverage") error("effective measurement option changed"))
unless(equal(maeGetAnalysis("Oscillator" "hbnoise" ?option "noiseout" ?session s) list("pm")) error("effective measurement option changed"))
modeBefore=maeGetEnvOption("Oscillator" ?option "controlMode" ?session s)
unless(maeSetEnvOption("Oscillator" ?options list(list("controlMode" "batch")) ?session s) error("set batch mode failed"))
unless(equal(maeGetEnvOption("Oscillator" ?option "controlMode" ?session s) "batch") error("batch mode readback mismatch"))
enabledBefore=maeGetSetup(?enabled t ?session s)
maeSetSetup(?tests maeGetSetup(?session s) ?enabled nil ?session s)
maeSetSetup(?tests list("Oscillator") ?enabled t ?session s)
runResult=errset(progn(
runId=maeRunSimulation(?waitUntilDone t ?returnRunId t ?session s)
unless(runId error("submission failed"))
maeWaitUntilDone('All ?session s)
maeExportOutputView(?fileName "/path/to/workspace/run/evaluated.csv" ?session s)
maeWaitUntilDone('All ?session s)
rd=axlGetRunData(s runId) hist=axlGetHistoryName(rd)
r=maeReadResDB(?historyName hist ?session s)
unless(r error("missing RDB"))
o=outfile("/path/to/workspace/run/points.tsv")
fprintf(o "HISTORY\t%s\n" hist)
he=axlGetHistoryEntry(axlGetMainSetupDB(s) hist)
fprintf(o "RDB\t%s\n" axlGetHistoryResults(he))
tbgenReadSignals=list("/DUT_OUTP" "/ENABLE" "/OUTN" "/OUTP" "/VDC" "/VDD" "/VDD_SRC/PLUS" "/main_B0" "/main_B1" "/main_B2" "/main_B3")
tbgenRequiredSignals=list("/OUTP" "/OUTN" "/VDD" "/VDD_SRC/PLUS")
tbgenNumberedDrain=nil
tbgenAnalysisNames=list("hb_fd" "hb_fi" "hb_td" "hbnoise" "hbnoise_pm")
tbgenExpressions=list(list("VDD_VALUE" "VAR(\"VDD\")") list("VCO_HB_F0_Hz" "drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)") list("VCO_HB_DIFF_PEAK_V" "mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))") list("VCO_HB_VDD_SRC_IDC_A" "0-real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0))") list("VCO_HB_VDD_SRC_PDC_W" "(0-real(value((0+getData(\"/VDD\" ?result \"hb_fd\")) 0))*real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0)))") list("VCO_HBNOISE_PN_10000Hz_dBc_Hz" "(10*log10(2)+20*log10(value(getData(\"out\" ?result \"hbnoise_pm\") 10000.0)/mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))))") list("VCO_HBNOISE_FOM_10000Hz_dB" "(10*log10(2)+20*log10(value(getData(\"out\" ?result \"hbnoise_pm\") 10000.0)/mag(value((getData(\"/OUTP\" ?result \"hb_fd\")-getData(\"/OUTN\" ?result \"hb_fd\")) drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)))))-20*log10(drGetElem(drGetWaveformXVec(getData(\"/OUTP\" ?result \"hb_fd\")) 1)/10000.0)+10*log10(1000*(0+(0-real(value((0+getData(\"/VDD\" ?result \"hb_fd\")) 0))*real(value(getData(\"/VDD_SRC/PLUS\" ?result \"hb_fd\") 0)))))"))
foreach(point r->points() foreach(corner point->corners() foreach(test corner->tests()
 fprintf(o "POINT\t%L\t%s\t%s\t%L\t%s\n" point->id corner->name test->name test->status test->resultsDir)
 foreach(param corner->params() fprintf(o "PARAM\t%s\t%L\n" param->name param->value))
 tbgenWaveNames=nil
 foreach(value test->outputs() when(member(value->value list("wave" 'wave)) tbgenWaveNames=cons(value->name tbgenWaveNames)) fprintf(o "OUTPUT\t%s\t%L\t%L\n" value->name value->type value->value))
 when(test->status=='done
  openResults(strcat(test->resultsDir "/psf"))
  foreach(ana results()
   fprintf(o "ANALYSIS\t%L\n" ana)
   when(member(if(symbolp(ana) then symbolToString(ana) else ana) tbgenAnalysisNames)
   tbgenActualSignals=outputs(?result ana)
   when(tbgenNumberedDrain && member(ana '(hb_fd hb_td))
    tbgenNumberedWave=nil
    foreach(alias cadr(tbgenNumberedDrain)
     unless(tbgenNumberedWave
      waveResult=errset(getData(alias ?result ana) nil)
      when(waveResult tbgenNumberedWave=car(waveResult))))
    when(tbgenNumberedWave
     tbgenSignal=car(tbgenNumberedDrain)
     tbgenEmitWave(o ana tbgenSignal tbgenNumberedWave nil)
     tbgenEmitOutput(o strcat("__save__" tbgenSignal) tbgenNumberedWave nil)))
   foreach(signal append(tbgenActualSignals if(member(ana '(hbnoise_pm pnoise)) then list("out") else nil))
    when(member(signal tbgenReadSignals) || ana=='hbxf || signal=="out" || signal==car(tbgenActualSignals)
    waveResult=errset(getData(signal ?result ana) nil)
    when(waveResult
     tbgenEmitWave(o ana signal car(waveResult) nil)
     when(member(signal tbgenRequiredSignals) tbgenEmitOutput(o strcat("__save__" signal) car(waveResult) nil)))))))
  foreach(expression tbgenExpressions
   when(member(car(expression) tbgenWaveNames)
   waveResult=errset(evalstring(cadr(expression)) nil)
   when(waveResult tbgenEmitOutput(o car(expression) car(waveResult) nil))))
))))
close(o)
) t)
maeSetEnvOption("Oscillator" ?options list(list("controlMode" modeBefore)) ?session s)
maeSetSetup(?tests maeGetSetup(?session s) ?enabled nil ?session s)
maeSetSetup(?tests enabledBefore ?enabled t ?session s)
maeSaveSetup(?session s) maeCloseSession(?session s)
unless(runResult error("simulation/result export failed"))
