when(ddGetObj("example_tb" "OscillatorTB") error("Refusing existing TB cell"))
unless(ddGetObj("example_tb" "isf_decimal_register")
f=ddGetObj("example_tb" "isf_decimal_register" "veriloga" "veriloga.va" nil "w")
unless(f error("VA view create failed"))
o=outfile(f~>writePath) fprintf(o "%s" "`include \"constants.vams\"\n`include \"disciplines.vams\"\nmodule isf_decimal_register(bits,vdd,vss);\n parameter integer WIDTH=4;\n parameter integer DEC_CODE=0;\n parameter integer INVERT=0 from [0:1];\n output [3:0] bits;\n inout vdd,vss;\n electrical [3:0] bits;\n electrical vdd,vss;\n genvar i;\n analog begin\n  @(initial_step) if (WIDTH!=4 || DEC_CODE<0 || DEC_CODE>=16)\n    $fatal(1,\"Invalid WIDTH or DEC_CODE\");\n  for(i=0;i<4;i=i+1) begin\n   V(bits[i],vss) <+ (((DEC_CODE>>i)&1)^INVERT)*V(vdd,vss);\n  end\n end\nendmodule\n") close(o) ddReleaseObj(f)
unless(ahdlUpdateViewInfo("example_tb" ?cell "isf_decimal_register" ?view "veriloga") error("VA interface extraction failed"))
cv=dbOpenCellViewByType("example_tb" "isf_decimal_register" "symbol" "schematicSymbol" "w")
dbCreateRect(cv list("device" "drawing") list(list(0 -0.5) list(2 1.5)))
n=dbCreateNet(cv "bits<3:0>") tm=dbCreateTerm(n "bits<3:0>" "output")
f=dbCreateRect(cv list("pin" "drawing") list(list(-0.025 -0.025) list(0.025 0.025)))
dbCreatePin(n f "bits<3:0>")
dbCreateLabel(cv list("device" "label") list(0.1 0.0) "bits<3:0>" "centerLeft" "R0" "roman" 0.0625)
n=dbCreateNet(cv "vdd") tm=dbCreateTerm(n "vdd" "inputOutput")
f=dbCreateRect(cv list("pin" "drawing") list(list(-0.025 0.475) list(0.025 0.525)))
dbCreatePin(n f "vdd")
dbCreateLabel(cv list("device" "label") list(0.1 0.5) "vdd" "centerLeft" "R0" "roman" 0.0625)
n=dbCreateNet(cv "vss") tm=dbCreateTerm(n "vss" "inputOutput")
f=dbCreateRect(cv list("pin" "drawing") list(list(-0.025 0.975) list(0.025 1.025)))
dbCreatePin(n f "vss")
dbCreateLabel(cv list("device" "label") list(0.1 1.0) "vss" "centerLeft" "R0" "roman" 0.0625)
dbReplaceProp(cv "instNamePrefix" "string" "I")
unless(dbSave(cv) error("symbol save failed"))
dbClose(cv)
c=cdfGetBaseCellCDF(ddGetObj("example_tb" "isf_decimal_register"))
unless(c c=cdfCreateBaseCellCDF(ddGetObj("example_tb" "isf_decimal_register")))
